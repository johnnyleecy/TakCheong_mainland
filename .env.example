# ===== 資料庫（本機 PostgreSQL） =====
DATABASE_URL="postgresql://postgres:1234@localhost:5432/takcheong_mainland?schema=public"

# ===== 網站 =====
NEXT_PUBLIC_SITE_URL="https://www.takcheong.cn"

# ===== Admin 後台 =====
ADMIN_PASSWORD="請修改為你自己的密碼"
AUTH_SECRET="請改為一串隨機字串（至少 32 字元）"

# ===== Gmail SMTP（自動回覆電郵） =====
# 使用 Gmail 寄信：smtp.gmail.com，465 埠（SSL）
# SMTP_USER 填 Gmail 帳號；SMTP_PASS 填「應用程式密碼」
# （需先開啟 Gmail 兩步驗證，再到 Google 帳戶→安全性→應用程式密碼 產生 16 碼密碼）
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="你的 Gmail 帳號"
SMTP_PASS="你的 Gmail 應用程式密碼"
MAIL_FROM="德昌五金 <你的@gmail.com>"
ADMIN_EMAIL="管理員收信信箱"

# ===== DeepSeek AI（聊天機器人） =====
DEEPSEEK_API_KEY="你的 DeepSeek API Key"
